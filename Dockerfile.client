FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    INFERENCE_BACKEND=remote \
    HOME=/tmp \
    APP_BIND=0.0.0.0:8000

WORKDIR /app
RUN useradd --no-create-home --uid 10001 --user-group --shell /usr/sbin/nologin app \
    && mkdir -p models/champion
COPY requirements/client.lock requirements/client.lock
RUN python -m pip install --no-cache-dir --no-compile --only-binary=:all: -r requirements/client.lock \
    && python -m pip check
COPY --chown=10001:10001 visionguard/ visionguard/
COPY --chown=10001:10001 cloud/model-manifest.json cloud/model-manifest.json
COPY --chown=10001:10001 wsgi.py gunicorn.conf.py ./
COPY --chown=10001:10001 docker/healthcheck.py ./healthcheck.py
ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=6 \
    CMD ["python", "healthcheck.py"]
CMD ["gunicorn", "--config", "gunicorn.conf.py", "wsgi:app"]
