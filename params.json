{
  "split": {
    "seed": 42,
    "train": 0.7,
    "validation": 0.15,
    "test": 0.15
  },
  "preprocessing": {
    "policy": "rgb-white-letterbox-v1",
    "image_size": 128,
    "batch_size": 16,
    "cache_in_memory": true
  },
  "cnn_baseline": {
    "seed": 42,
    "epochs": 20,
    "filters": [
      16,
      32,
      64
    ],
    "dense_units": 64,
    "dropout": 0.3,
    "learning_rate": 0.001,
    "early_stopping_patience": 5,
    "lr_patience": 2,
    "augmentation": {
      "rotation": 0.05,
      "zoom": 0.1
    }
  },
  "mobilenetv2": {
    "seed": 42,
    "alpha": 1.0,
    "dense_units": 64,
    "dropout": 0.3,
    "augmentation": {
      "rotation": 0.05,
      "zoom": 0.1
    },
    "frozen": {
      "epochs": 12,
      "learning_rate": 0.001,
      "early_stopping_patience": 3,
      "lr_patience": 2
    },
    "finetuned": {
      "epochs": 8,
      "learning_rate": 1e-05,
      "early_stopping_patience": 3,
      "lr_patience": 2,
      "unfreeze_prefix": "block_16_"
    }
  }
}
